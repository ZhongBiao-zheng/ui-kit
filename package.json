{
  "name": "ui-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "lint": "tsc -b --noEmit && eslint .",
    "test": "vitest run",
    "tokens": "node scripts/tokens.mjs",
    "design:lint": "design.md lint DESIGN.md",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "registry": "node scripts/registry.mjs && shadcn build",
    "site": "pnpm registry && pnpm build-storybook && node scripts/site.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.4.0",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chromatic": "^18.13.4",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "shadcn": "4.23.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "packageManager": "pnpm@11.1.2"
}
